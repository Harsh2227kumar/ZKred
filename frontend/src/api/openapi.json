{
  "openapi": "3.1.0",
  "info": {
    "title": "ZKred API",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "db": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "chain": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "ai": {
            "type": "string",
            "enum": [
              "ok",
              "down"
            ]
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "chain",
          "ai",
          "version"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Enums": {
        "type": "object",
        "properties": {
          "issuer_kinds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnumOption"
            }
          },
          "credential_types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnumOption"
            }
          },
          "key_statuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnumOption"
            }
          },
          "batch_statuses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnumOption"
            }
          },
          "predicate_types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnumOption"
            }
          },
          "verification_steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnumOption"
            }
          },
          "verification_results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EnumOption"
            }
          }
        },
        "required": [
          "issuer_kinds",
          "credential_types",
          "key_statuses",
          "batch_statuses",
          "predicate_types",
          "verification_steps",
          "verification_results"
        ]
      },
      "EnumOption": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "value",
          "label"
        ]
      },
      "ChainInfo": {
        "type": "object",
        "properties": {
          "chain_id": {
            "type": "integer"
          },
          "network_name": {
            "type": "string"
          },
          "issuer_registry": {
            "$ref": "#/components/schemas/Address"
          },
          "anchor_registry": {
            "$ref": "#/components/schemas/Address"
          },
          "status_registry": {
            "$ref": "#/components/schemas/Address"
          },
          "explorer_tx_url_template": {
            "type": "string"
          },
          "breach_window_seconds": {
            "type": "integer"
          },
          "demo_mode": {
            "type": "boolean"
          }
        },
        "required": [
          "chain_id",
          "network_name",
          "issuer_registry",
          "anchor_registry",
          "status_registry",
          "explorer_tx_url_template",
          "breach_window_seconds",
          "demo_mode"
        ]
      },
      "Address": {
        "type": "string",
        "pattern": "^0x[0-9a-fA-F]{40}$",
        "description": "0x-prefixed 20-byte EVM address"
      },
      "CredentialSchemaList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CredentialSchema"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "CredentialSchema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "version": {
            "type": "integer"
          },
          "fields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CredentialSchemaField"
            }
          }
        },
        "required": [
          "type",
          "version",
          "fields"
        ]
      },
      "CredentialSchemaField": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "string",
              "date",
              "int"
            ]
          },
          "pii": {
            "type": "boolean"
          },
          "index": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "enum": [
              "meta",
              "claim",
              "derived"
            ]
          }
        },
        "required": [
          "name",
          "label",
          "kind",
          "pii",
          "index",
          "source"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "Dependency health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "default": {
            "description": "Standard error (CONTRACTS §2)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/meta/enums": {
      "get": {
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "Option lists for the UI",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Enums"
                }
              }
            }
          },
          "default": {
            "description": "Standard error (CONTRACTS §2)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/meta/chain": {
      "get": {
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "Chain + contract details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainInfo"
                }
              }
            }
          },
          "default": {
            "description": "Standard error (CONTRACTS §2)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/meta/credential-schemas": {
      "get": {
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "Credential layouts (BBS message order)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialSchemaList"
                }
              }
            }
          },
          "default": {
            "description": "Standard error (CONTRACTS §2)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}