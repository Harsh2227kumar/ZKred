# ========================================================
# ZKred — Frontend Environment Variables Template (.env.example)
# Conforms strictly to frontend/src/config.ts & CONTRACTS.md §6
# ========================================================

# Base URL for backend API requests (behind Caddy in prod, or direct Express port in local dev)
VITE_API_BASE_URL=/api/v1

# Base URL where compiled ZK artifacts (age_gte.wasm, age_gte.zkey, vkey.json) are served
VITE_ZK_ARTIFACTS_BASE_URL=/zk

# Optional: default recovery passphrase for seeded demo personas (Asha, Meera)
VITE_DEMO_WALLET_PASSPHRASE=zkred-demo-passphrase-2026
