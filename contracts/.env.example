# contracts/.env — read only by contracts/hardhat.config.ts (via configVariable) and passed into the
# Docker wrapper (contracts/scripts/in-docker.sh). Copy to contracts/.env; never commit the real file.
# Only needed for `deploy:base-sepolia`; `test` and `deploy:local` need none of these.

# Funded Base Sepolia account that deploys the registries. It also becomes the accreditor, so the
# same key goes into the backend .env as ACCREDITOR_PRIVATE_KEY. 0x-prefixed, 32 bytes hex.
DEPLOYER_PRIVATE_KEY=

# Base Sepolia JSON-RPC endpoint (public endpoint, Alchemy, Infura, QuickNode, ...).
BASE_SEPOLIA_RPC_URL=

# Etherscan API key (Etherscan v2 keys cover BaseScan); only used for contract verification.
BASESCAN_API_KEY=
