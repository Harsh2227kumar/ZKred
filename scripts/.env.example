# ========================================================
# ZKred — Scripts / Seed Pipeline Environment Variables (.env.example)
# Conforms strictly to scripts/config.ts & CONTRACTS.md §6
# ========================================================

# Seed v2: `pnpm --filter scripts seed` (legacy credentials), then `pnpm --filter scripts seed:in-window` at least
# BREACH_WINDOW_SECONDS later, right before the breach demo. All three values are required.
SEED_API_BASE_URL=http://localhost:8080/api/v1
# Same value as ISSUER_ADMIN_TOKEN in the root .env.
SEED_ADMIN_TOKEN=
# Encrypts the seed holder wallet's backup; pick any 10+ character passphrase.
SEED_WALLET_PASSPHRASE=
