# ========================================================
# ZKred — Root Environment Variables Template (.env.example)
# Conforms strictly to backend/src/config.ts & CONTRACTS.md §6
# Copy to .env (never commit it). Blank required values make the backend refuse to start.
# ========================================================

# Deployment & Docker Compose
# Local: localhost. EC2: <public-ip>.sslip.io or your domain.
DOMAIN=localhost
# Not read by the Caddyfile yet (Let's Encrypt issues certificates without a contact email).
ACME_EMAIL=
POSTGRES_USER=postgres
# Local: any value. EC2: openssl rand -hex 24
POSTGRES_PASSWORD=postgres
POSTGRES_DB=zkred

# Backend Server Core
# EC2: production
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
# Used when running the backend on the host; docker compose overrides it with the db container URL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zkred
# EC2: https://<DOMAIN> for both.
CORS_ORIGINS=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

# Admin & Key Security — generate fresh values per environment:
#   ISSUER_ADMIN_TOKEN:               openssl rand -hex 32
#   KEY_ENCRYPTION_SECRET:            openssl rand -base64 32
#   GOVERNANCE_KEY_ENCRYPTION_SECRET: openssl rand -base64 32   (must differ from the one above)
ISSUER_ADMIN_TOKEN=
KEY_ENCRYPTION_SECRET=
GOVERNANCE_KEY_ENCRYPTION_SECRET=
DEMO_MODE=true

# Chain (Base Sepolia registries deployed in V0-H3; see contracts/deployments/baseSepolia.json)
CHAIN_ID=84532
CHAIN_NETWORK_NAME=Base Sepolia
CHAIN_RPC_URL=https://sepolia.base.org
# Same key as DEPLOYER_PRIVATE_KEY in contracts/.env (the accreditor). Ask HARSH; never commit it.
ACCREDITOR_PRIVATE_KEY=
ISSUER_REGISTRY_ADDRESS=0x7AD1dc8a22923df3a7997AC002cfb4b32Ad6AEa8
ANCHOR_REGISTRY_ADDRESS=0x12DA5d65d4C7d46d900D7512C4096503fCD29Cfd
STATUS_REGISTRY_ADDRESS=0xeee916756f6a810034af451FC80f77aD00d8a0c0
EXPLORER_TX_URL_TEMPLATE=https://sepolia.basescan.org/tx/{tx}
ISSUER_GAS_FUNDING_WEI=2000000000000000
# Max wait for a tx to be mined, and how often ethers polls for blocks / receipts
CHAIN_TX_TIMEOUT_MS=120000
CHAIN_POLL_INTERVAL_MS=1000

# Operational Protocol Limits
BREACH_WINDOW_SECONDS=172800
REQUEST_TTL_SECONDS=900
STATUS_LIST_SIZE=16384
BATCH_MAX_SIZE=256
# Max characters per issued claim value; default and max page size for list endpoints
CLAIM_MAX_CHARS=256
LIST_DEFAULT_LIMIT=50
LIST_MAX_LIMIT=200
AGE_PROOF_MAX_SKEW_DAYS=1
ZK_ARTIFACTS_DIR=circuits/build

# AWS Bedrock AI (cross-region inference profile id; a bare anthropic.* id fails)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6
# Auth: set ONE of — a Bedrock API key, an IAM key pair, or neither when the EC2 instance role has bedrock:InvokeModel*.
AWS_BEARER_TOKEN_BEDROCK=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=4000
AI_HEALTH_TTL_MS=300000
# Consent text timeout (no retry) before the deterministic template is used
AI_CONSENT_TIMEOUT_MS=8000
# Per client IP and window: parse + request create (Bedrock), presentation submissions
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AI_MAX=10
RATE_LIMIT_VERIFY_MAX=30
# GET /issuers reuses on-chain issuer reads this long (verification always reads the chain)
ISSUER_CACHE_TTL_MS=30000
HEALTH_CHECK_TIMEOUT_MS=3000
